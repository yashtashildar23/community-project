{
  "name": "mindline",
  "version": "1.0.0",
  "private": true,
  "description": "Mental Health Awareness & Helpline Directory App - offline-first, privacy-first crisis support.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start": "npm --prefix server run start",
    "build": "npm --prefix client run build",
    "deploy": "npm run build && wrangler pages deploy",
    "deploy:direct": "wrangler pages deploy",
    "install:all": "npm install",
    "seed": "npm --prefix server run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wrangler": "^4.166.0"
  }
}
